# Leave all keys empty to run with the offline mock LLM.
LLM_PROVIDER=            # anthropic | openai | mock (auto-detected from keys when empty)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=         # optional: Azure / internal OpenAI-compatible gateway
MAX_QUESTIONS=6
CHECKPOINT_DB=handover_checkpoints.sqlite
